#!/usr/bin/env bash
# unidpp-ops — deployment backup and restore (the durability contract).
#
#   ./unidpp-ops backup  [name]        # snapshot the deployment (default:
#                                      #  the tenant named by the root manifest)
#   ./unidpp-ops restore <archive> <name> [--force]
#   ./unidpp-ops verify <archive>      # checksums only
#   ./unidpp-ops schedule [--install]  # the nightly backup cron line
#                                      #  (--install merges it idempotently)
#   ./unidpp-ops prune [--keep N] [--apply]
#                                      # retention: LIST backups beyond the
#                                      #  newest N (report-only unless --apply)
#   ./unidpp-ops bundle <tenant> [--data-only] [--out dir]
#                                      # the on-prem whitelabel artifact:
#                                      #  manifest + declared-service
#                                      #  binaries + runner + runbook,
#                                      #  verified exactly like a backup
#                                      #  (--data-only: the tenant-state
#                                      #  artifact for a deployment that
#                                      #  already has its engine)
#   ./unidpp-ops drill [--keep]        # the restore rehearsal: backup ->
#                                      #  restore into a drill tenant ->
#                                      #  checksums + byte parity + manifest
#                                      #  validation -> JSON drill report
#
# What a backup is: the deployment AS DATA — the operator manifest,
# every journal (registry root journal, run/*-journal, every tenant's
# journals), and the seed assets — in a versioned tar.gz next to a
# JSON sidecar carrying per-file sha256s, the UTC moment, and the log
# tree head as the consistency point (journals are append-only; the
# tree head at snapshot time is what a restore replays up to).
#
# Restore refuses to overwrite an existing tenant without --force and
# verifies every checksum before unpacking a single file.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
BACKUPS_DIR="$ROOT/backups"

die() { echo "unidpp-ops: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required but not installed"; }
need tar
need shasum

sha256_of() { shasum -a 256 "$1" | awk '{print $1}'; }

manifest_name() { # deployment name from a manifest, or fallback
  local manifest="$1"
  python3 - "$manifest" <<'PYEOF'
import re, sys
text = open(sys.argv[1]).read()
m = re.search(r'^\s*name:\s*([A-Za-z0-9._-]+)\s*$', text, re.M)
print(m.group(1) if m else "deployment")
PYEOF
}

cmd_backup() {
  local tenant="${1:-$(manifest_name "$ROOT/unidpp-operator.yaml")}"
  local stamp label archive sidecar
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  label="${tenant}-${stamp}"
  archive="$BACKUPS_DIR/$label.tar.gz"
  sidecar="$BACKUPS_DIR/$label.json"
  mkdir -p "$BACKUPS_DIR"

  # The consistency point: the log's signed tree head right now (best
  # effort — a deployment without the log running still backs up).
  local tree_head="unavailable"
  if curl -sf -m 3 http://127.0.0.1:8392/tree/head >/tmp/unidpp-ops-head.$$ 2>/dev/null; then
    tree_head="$(python3 -c "import json; d=json.load(open('/tmp/unidpp-ops-head.$$')); print(f\"size {d.get('tree_size')} root {d.get('root')}\")")"
  fi
  rm -f /tmp/unidpp-ops-head.$$

  # The payload: manifest + journals + seed. Derived state (run/ logs,
  # demo/, backups/) is excluded by construction — data, not exhaust.
  local files=()
  [ -f "$ROOT/unidpp-operator.yaml" ] && files+=("unidpp-operator.yaml")
  [ -f "$ROOT/registry-journal.jsonl" ] && files+=("registry-journal.jsonl")
  [ -f "$ROOT/jp-registry-journal.jsonl" ] && files+=("jp-registry-journal.jsonl")
  while IFS= read -r journal; do files+=("${journal#"$ROOT"/}"); done \
    < <(find "$ROOT/run" "$ROOT/tenants" -name '*-journal.jsonl' 2>/dev/null)
  while IFS= read -r seed; do files+=("${seed#"$ROOT"/}"); done \
    < <(find "$ROOT/seed" -type f 2>/dev/null)
  [ "${#files[@]}" -ge 1 ] || die "nothing to back up (no manifest?)"

  tar -czf "$archive" -C "$ROOT" "${files[@]}"

  # The sidecar: every member's checksum + the consistency point.
  python3 - "$archive" "$label" "$tree_head" "$tenant" <<'PYEOF'
import hashlib, json, os, sys, tarfile
archive, label, tree_head, tenant = sys.argv[1:5]
members = {}
with tarfile.open(archive) as tf:
    for m in tf.getmembers():
        if m.isfile():
            members[m.name] = hashlib.sha256(tf.extractfile(m).read()).hexdigest()
doc = {
    "backup": label,
    "tenant": tenant,
    "taken_at_utc": label.split("-", 1)[1] if "-" in label else "",
    "consistency_point": {"log_tree_head": tree_head},
    "file_count": len(members),
    "sha256": members,
}
with open(os.path.join(os.path.dirname(archive), label + ".json"), "w") as fh:
    json.dump(doc, fh, indent=2, sort_keys=True)
print(f"backup: {label}")
print(f"  files: {len(members)}  consistency point: {tree_head}")
PYEOF
  echo "  archive: $archive"
}

verify_archive() { # verify <archive> -> ok | dies
  local archive="$1" sidecar="${1%.tar.gz}.json"
  [ -f "$archive" ] || die "no such archive: $archive"
  [ -f "$sidecar" ] || die "no sidecar for $archive (a backup is archive+sidecar)"
  python3 - "$archive" "$sidecar" <<'PYEOF'
import hashlib, json, sys, tarfile
archive, sidecar = sys.argv[1:3]
doc = json.load(open(sidecar))
bad = []
with tarfile.open(archive) as tf:
    names = {m.name for m in tf.getmembers() if m.isfile()}
    for name, want in doc["sha256"].items():
        if name not in names:
            bad.append(f"missing member {name}")
            continue
        got = hashlib.sha256(tf.extractfile(name).read()).hexdigest()
        if got != want:
            bad.append(f"checksum mismatch: {name}")
if bad:
    print("unidpp-ops: archive FAILED verification:", file=sys.stderr)
    for b in bad:
        print(f"  {b}", file=sys.stderr)
    sys.exit(1)
print(f"verified: {len(doc['sha256'])} member(s), consistency point {doc['consistency_point']['log_tree_head']}")
PYEOF
}

cmd_verify() { verify_archive "$1"; }

cmd_restore() {
  local archive="$1" tenant="$2" force="${3:-}"
  [ "$force" = "--force" ] || [ -z "$force" ] || die "usage: restore <archive> <name> [--force]"
  verify_archive "$archive"
  local target="$ROOT/tenants/$tenant"
  if [ -e "$target" ] && [ "$force" != "--force" ]; then
    die "tenant '$tenant' already exists — pass --force to replace it (the existing directory is renamed aside, never deleted)"
  fi
  if [ -e "$target" ]; then
    mv "$target" "$target.pre-restore.$(date -u +%Y%m%dT%H%M%SZ)"
  fi
  mkdir -p "$target"
  # Restore INTO the tenant dir: the manifest lands at its root, the
  # journals under it (paths inside tenants/<old>/ are rewritten).
  python3 - "$archive" "$target" "$tenant" <<'PYEOF'
import json, os, sys, tarfile
archive, target, tenant = sys.argv[1:4]
origin = json.load(open(archive[:-len(".tar.gz")] + ".json")).get("tenant")
with tarfile.open(archive) as tf:
    members = [m for m in tf.getmembers() if m.isfile()]
    # Bundle layout: every member under ONE shared top-level directory
    # (e.g. acme-cn/...) — strip it, then the backup rules apply.
    firsts = {m.name.split("/")[0] for m in members}
    strip_prefix = ""
    if len(firsts) == 1 and not any("/" not in m.name for m in members):
        strip_prefix = next(iter(firsts)) + "/"
    for m in members:
        name = m.name[len(strip_prefix):] if strip_prefix else m.name
        # Only the backup's OWN tenant journals rewrite into the
        # restored one (they are the deployment's live state); other
        # tenants' journals are archive material and keep their
        # original tenant path — rewriting them all would collide
        # sibling tenants onto the same filenames.
        parts = name.split("/")
        if len(parts) >= 2 and parts[0] == "tenants" and parts[1] == origin:
            parts[1] = tenant
            name = "/".join(parts)
        out = os.path.join(target, os.path.relpath(name, "unidpp-operator.yaml") if False else name)
        os.makedirs(os.path.dirname(out), exist_ok=True)
        with open(out, "wb") as fh:
            fh.write(tf.extractfile(m).read())
print(f"restored into tenants/{tenant} (origin tenant: {origin})")
PYEOF
  # The restored manifest becomes the tenant's own, with its journal
  # paths rewritten into the tenant (a restored deployment must never
  # write the origin's journals) and its name rebased to the tenant.
  if [ -f "$target/unidpp-operator.yaml" ]; then
    python3 - "$target/unidpp-operator.yaml" "$tenant" <<'PYEOF'
import re, sys
path, tenant = sys.argv[1:3]
text = open(path).read()
text = re.sub(r"state_file:\s*registry-journal\.jsonl",
              f"state_file: tenants/{tenant}/registry-journal.jsonl", text)
text = re.sub(r"state_file:\s*jp-registry-journal\.jsonl",
              f"state_file: tenants/{tenant}/jp-registry-journal.jsonl", text)
text = re.sub(r"state_file:\s*tenants/[A-Za-z0-9._-]+/",
              f"state_file: tenants/{tenant}/", text)
text = re.sub(r"state_file:\s*run/([a-z-]+)-journal\.jsonl",
              f"state_file: tenants/{tenant}/\\1-journal.jsonl", text)
text = re.sub(r"^(\s*name:\s*)[A-Za-z0-9._-]+$", rf"\1{tenant}", text, count=1, flags=re.M)
open(path, "w").write(text)
PYEOF
  fi
  echo "restored manifest rewritten: journals under tenants/$tenant, name $tenant"
  echo "review the binds in its manifest, then: ./tenants/up.sh $tenant"
}

# ---------------------------------------------------------------------------
# schedule — the nightly backup cron line (idempotent install)
# ---------------------------------------------------------------------------
SCHEDULE_MARKER="unidpp-ops: nightly backup"
schedule_line() {
  printf '17 3 * * * cd %s && ./unidpp-ops backup >> backups/schedule.log 2>&1 # %s' \
    "$ROOT" "$SCHEDULE_MARKER"
}

cmd_schedule() {
  local install="${1:-}"
  if [ "$install" = "--status" ]; then
    if printf '%s\n' "$(crontab -l 2>/dev/null || true)" \
      | grep -Fq "$SCHEDULE_MARKER"; then
      echo "installed: the nightly backup runs at 03:17 (crontab -l)"
    else
      echo "not installed — pass --install to add the nightly backup cron"
    fi
    return 0
  fi
  [ "$install" = "--install" ] || [ -z "$install" ] \
    || die "usage: schedule [--install|--status]"
  if [ "$install" != "--install" ]; then
    echo "cron line (print-only; pass --install to add it to the crontab):"
    schedule_line; echo
    return 0
  fi
  local current
  current="$(crontab -l 2>/dev/null || true)"
  if printf '%s\n' "$current" | grep -Fq "$SCHEDULE_MARKER"; then
    echo "schedule: already installed (marker present in the crontab)"
    return 0
  fi
  { [ -z "$current" ] || printf '%s\n' "$current"; schedule_line; echo; } | crontab -
  echo "schedule: installed (17 3 * * * nightly — see 'crontab -l')"
}

# ---------------------------------------------------------------------------
# prune — retention, report-only by default (deletion is an explicit act)
# ---------------------------------------------------------------------------
cmd_prune() {
  local keep=14 apply=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --keep) keep="$2"; shift 2 ;;
      --keep=*) keep="${1#--keep=}"; shift ;;
      --apply) apply=1; shift ;;
      *) die "usage: prune [--keep N] [--apply]" ;;
    esac
  done
  case "$keep" in (*[!0-9]*|"") die "--keep needs a number" ;; esac
  local archives=() a
  while IFS= read -r a; do archives+=("$a"); done \
    < <(ls -1 "$BACKUPS_DIR"/*.tar.gz 2>/dev/null | sort -r)
  local total=${#archives[@]} idx=0
  echo "prune: $total backup(s), keeping the newest $keep"
  for a in "${archives[@]}"; do
    idx=$((idx + 1))
    [ "$idx" -le "$keep" ] && continue
    if [ -n "$apply" ]; then
      rm -f "$a" "${a%.tar.gz}.json"
      echo "  deleted:  $(basename "$a") (+ sidecar)"
    else
      echo "  candidate: $(basename "$a") (+ sidecar)"
    fi
  done
  if [ "$total" -gt "$keep" ] && [ -z "$apply" ]; then
    echo "  report-only — pass --apply to delete exactly the listed backup(s)"
  fi
}

# ---------------------------------------------------------------------------
# drill — the restore rehearsal (a backup nobody ever restored is a
# hope, not a capability). Creates and owns its drill tenant; never
# touches production state; removes what it created unless --keep.
# ---------------------------------------------------------------------------
cmd_drill() {
  local keep_tenant="${1:-}"
  [ "$keep_tenant" = "--keep" ] || [ -z "$keep_tenant" ] \
    || die "usage: drill [--keep]"
  local started drill_tenant archive label
  started="$(date -u +%s)"
  drill_tenant="drill-$(date -u +%Y%m%dT%H%M%SZ)"
  [ ! -e "$ROOT/tenants/$drill_tenant" ] \
    || die "drill tenant exists: $drill_tenant (refusing to touch it)"
  mkdir -p "$BACKUPS_DIR"

  echo "drill: 1/4 backup"
  cmd_backup drill >/dev/null
  archive="$(ls -1t "$BACKUPS_DIR"/drill-*.tar.gz 2>/dev/null | head -1)"
  [ -n "$archive" ] || die "drill: the backup produced no archive"
  label="$(basename "$archive" .tar.gz)"

  echo "drill: 2/4 restore into tenants/$drill_tenant"
  cmd_restore "$archive" "$drill_tenant" >/dev/null

  echo "drill: 3/4 parity + manifest validation"
  local parity_failed=0
  python3 - "$archive" "$ROOT/tenants/$drill_tenant" "$BACKUPS_DIR/$label.drill.json" <<'PYIN' || parity_failed=1
import hashlib, json, sys, tarfile
archive, target, report_path = sys.argv[1:4]
doc = json.load(open(archive[:-len(".tar.gz")] + ".json"))
byte_equal, checked = 0, 0
tenant = target.rsplit("/", 1)[-1]
origin = doc.get("tenant")
for name, want in doc["sha256"].items():
    parts = name.split("/")
    if len(parts) >= 2 and parts[0] == "tenants" and parts[1] == origin:
        parts[1] = tenant  # mirror the restore's origin-tenant rewrite
        name = "/".join(parts)
    out = f"{target}/{name}"
    if name == "unidpp-operator.yaml":
        continue  # rewritten by design (journal paths, tenant name)
    got = hashlib.sha256(open(out, "rb").read()).hexdigest()
    checked += 1
    if got == want:
        byte_equal += 1
report = {
    "drill": label if (label := doc.get("backup")) else "",
    "files": len(doc["sha256"]),
    "consistency_point": doc["consistency_point"]["log_tree_head"],
    "checksums": "verified (restore-time)",
    "byte_parity": f"{byte_equal}/{checked} members byte-identical after restore",
}
json.dump(report, open(report_path, "w"), indent=2, sort_keys=True)
print(f"  byte parity: {byte_equal}/{checked} members identical")
if byte_equal != checked:
    sys.exit(1)
PYIN
  if [ "$parity_failed" = 1 ]; then
    rm -rf "$ROOT/tenants/$drill_tenant"
    die "drill failed at byte parity (report kept)"
  fi
  local config_bin="$ROOT/../unidpp-config/target/release/unidpp-config"
  local manifest_ok="skipped (unidpp-config binary not built)"
  if [ -x "$config_bin" ]; then
    if "$config_bin" validate "$ROOT/tenants/$drill_tenant/unidpp-operator.yaml" >/dev/null 2>&1; then
      manifest_ok="valid"
    else
      rm -rf "$ROOT/tenants/$drill_tenant"
      die "drill failed: the restored manifest does not validate"
    fi
  fi
  python3 - "$BACKUPS_DIR/$label.drill.json" "$manifest_ok" <<'PYIN'
import json, sys
doc = json.load(open(sys.argv[1]))
doc["manifest_validated"] = sys.argv[2]
json.dump(doc, open(sys.argv[1], "w"), indent=2, sort_keys=True)
PYIN

  echo "drill: 4/4 report"
  if [ "$keep_tenant" != "--keep" ]; then
    rm -rf "$ROOT/tenants/$drill_tenant"
    echo "  drill tenant removed (pass --keep to retain it)"
  else
    echo "  drill tenant kept: tenants/$drill_tenant"
  fi
  echo "drill: GREEN in $(( $(date -u +%s) - started ))s — report: backups/$label.drill.json"
}

# ---------------------------------------------------------------------------
# bundle — the on-prem whitelabel artifact: everything a sovereign
# customer needs on their own host, verified like a backup. The
# manifest is the model: only the services it declares ship.
# ---------------------------------------------------------------------------
cmd_bundle() {
  local tenant="${1:?usage: bundle <tenant> [--data-only] [--out dir]}"
  local out_dir="$BACKUPS_DIR" data_only=""
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --data-only) data_only=1; shift ;;
      --out) out_dir="$2"; shift 2 ;;
      *) die "usage: bundle <tenant> [--data-only] [--out dir]" ;;
    esac
  done
  local config_cli="$ROOT/../unidpp-config/target/release/unidpp-config"
  [ -x "$config_cli" ] || die "unidpp-config binary missing (build ../unidpp-config)"
  local manifest="$ROOT/tenants/$tenant/unidpp-operator.yaml"
  [ -f "$manifest" ] || die "no tenant manifest at $manifest"
  "$config_cli" validate "$manifest" >/dev/null \
    || die "tenant manifest does not validate — fix it before bundling"

  local stamp label stage archive
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  label="$tenant-bundle-$stamp"
  [ -n "$data_only" ] && label="$tenant-data-$stamp"
  stage="$(mktemp -d)"
  archive="$out_dir/$label.tar.gz"
  mkdir -p "$out_dir" "$stage/$tenant/bin"

  # The manifest (verbatim — secrets in manifests are ${VAR} refs by
  # construction; render-env substitutes at the target host) + state.
  cp "$manifest" "$stage/$tenant/unidpp-operator.yaml"
  local journals=() j
  while IFS= read -r j; do journals+=("${j#$ROOT/}"); done \
    < <(find "$ROOT/tenants/$tenant" -name '*.jsonl' 2>/dev/null)
  for j in "${journals[@]}"; do
    mkdir -p "$stage/$tenant/$(dirname "$j")"
    cp "$ROOT/$j" "$stage/$tenant/$j"
  done

  # Binaries for exactly the declared services (the manifest is the
  # model), the config CLI (validate/render-env on the target), the
  # tenant runner, and this ops contract. The data-only artifact
  # carries none of these: it is tenant STATE for a deployment that
  # already has its engine.
  if [ -z "$data_only" ]; then
    local svc bin
    while IFS= read -r svc; do
      bin="$ROOT/../unidpp-$svc/target/release/unidpp-$svc"
      [ -x "$bin" ] || die "binary for declared service '$svc' missing: $bin"
      cp "$bin" "$stage/$tenant/bin/"
    done < <("$config_cli" services "$manifest")
    cp "$config_cli" "$stage/$tenant/bin/"
    cp "$ROOT/tenants/up.sh" "$stage/$tenant/"
    cp "$ROOT/unidpp-ops" "$stage/$tenant/"
  fi

  # First-boot env template: every ${VAR} the manifest references.
  { grep -oE '\$\{[A-Z0-9_]+\}' "$manifest" || true; } | sort -u \
    | sed 's/^\${\(.*\)}$/\1=/' > "$stage/$tenant/.env.template"

  cat > "$stage/$tenant/RUNBOOK.md" <<RUNBOOK
# $tenant — on-prem deployment bundle

This bundle IS a deployment: the manifest (unidpp-operator.yaml) is
the data; the binaries are the engine. Produced $(date -u +%Y-%m-%dT%H:%M:%SZ)Z.

## First boot

    ./unidpp-config validate unidpp-operator.yaml   # always validate first
    cp .env.template .env                           # fill every \${VAR}
    ./up.sh $tenant start                           # render-env + services

Ports, state files, suites, sovereignty rules: read them from the
manifest — the runner and the services take everything from it.

## Durability

    ./unidpp-ops backup    # snapshot (journals + manifest + seed)
    ./unidpp-ops drill     # the restore rehearsal
    ./unidpp-ops verify <archive>

Full manuals: https://docs.unidpp.org (operations, manifest
reference, every service API).

## Verify this bundle

    shasum -a 256 -c <(python3 -c "import json;print('\\n'.join(f'{v}  {k}' for k,v in json.load(open('bundle.json'))['sha256'].items()))")
RUNBOOK

  tar -czf "$archive" -C "$stage" "$tenant"
  python3 - "$archive" "$label" "$tenant" "$out_dir" <<'PYIN'
import hashlib, json, os, sys, tarfile
archive, label, tenant, out_dir = sys.argv[1:5]
members = {}
with tarfile.open(archive) as tf:
    for m in tf.getmembers():
        if m.isfile():
            members[m.name] = hashlib.sha256(tf.extractfile(m).read()).hexdigest()
doc = {
    "bundle": label,
    "tenant": tenant,
    "taken_at_utc": label.rsplit("-", 1)[-1],
    "consistency_point": {"log_tree_head": "n/a (a bundle is configuration + binaries, not a journal snapshot)"},
    "file_count": len(members),
    "sha256": members,
}
json.dump(doc, open(os.path.join(out_dir, label + ".json"), "w"), indent=2, sort_keys=True)
print(f"bundle: {label}")
print(f"  files: {len(members)}  archive: {archive}")
PYIN
  rm -rf "$stage"
}

# ---------------------------------------------------------------------------
# rehearse-upgrade — the operator's upgrade drill: backup -> rebuild
# the binaries -> restart (journals replay) -> prove the state equal
# and the journals append-only. An upgrade never rehearsed is an
# outage waiting for a calendar slot.
# ---------------------------------------------------------------------------
svc_bind() { # svc_bind <service> — from the manifest's rendered env
  local rendered
  rendered="$("$ROOT/../unidpp-config/target/release/unidpp-config" \
    render-env "$1" "$ROOT/unidpp-operator.yaml" 2>/dev/null \
    | grep -E '^UNIDPP_[A-Z_]*BIND=' | head -1)" || true
  printf '%s' "${rendered#*=}"
}

# Domain readings (what the state IS, not just file sizes) + journal
# line counts. Binds come from the manifest (svc_bind) — the pilot's
# ops never hardcodes ports.
rehearse_readings() { # rehearse_readings <binds-map>
  python3 - "$ROOT" "$1" <<'PYIN'
import json, os, sys, urllib.request
root, binds = sys.argv[1], sys.argv[2]
ports = dict(kv.split("=", 1) for kv in binds.split(",") if "=" in kv)
def get(path):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{path}", timeout=3) as r:
            return json.load(r)
    except Exception:
        return None
readings = {}
if "registry" in ports:
    doc = get(f"{ports['registry']}/items")
    readings["registry_items"] = len(doc["items"]) if doc else None
if "trust" in ports:
    doc = get(f"{ports['trust']}/revocations")
    readings["trust_revocations"] = len(doc["revocations"]) if doc else None
if "log" in ports:
    doc = get(f"{ports['log']}/tree/head")
    readings["log_tree_size"] = doc["tree_size"] if doc else None
lines = {}
for rel in ["registry-journal.jsonl", "jp-registry-journal.jsonl"]:
    p = os.path.join(root, rel)
    if os.path.exists(p):
        lines[rel] = sum(1 for _ in open(p))
for sub in ["run", "tenants"]:
    base = os.path.join(root, sub)
    for dirpath, _dirs, files in os.walk(base):
        for f in files:
            if f.endswith("-journal.jsonl") or (sub == "tenants" and f.endswith(".jsonl")):
                rel = os.path.relpath(os.path.join(dirpath, f), root)
                lines[rel] = sum(1 for _ in open(os.path.join(dirpath, f)))
readings["journal_lines"] = lines
print(json.dumps(readings, sort_keys=True))
PYIN
}

cmd_rehearse() {
  local config_cli="$ROOT/../unidpp-config/target/release/unidpp-config"
  [ -x "$config_cli" ] || die "unidpp-config binary missing (build ../unidpp-config)"
  local label="upgrade-$(date -u +%Y%m%dT%H%M%SZ)"
  local started="$(date -u +%s)"

  local binds="" svc
  for svc in registry trust log issuer; do
    binds="${binds:+$binds,}$svc=$(svc_bind "$svc")"
  done

  echo "rehearse: 1/5 backup"
  cmd_backup upgrade >/dev/null
  local archive
  archive="$(ls -1t "$BACKUPS_DIR"/upgrade-*.tar.gz 2>/dev/null | head -1)"
  [ -n "$archive" ] || die "rehearse: no backup archive produced"

  echo "rehearse: 2/5 before-readings"
  rehearse_readings "$binds" > "$BACKUPS_DIR/$label.before.json"

  echo "rehearse: 3/5 rebuild (the binary swap)"
  local repo
  for repo in unidpp-registry unidpp-trust unidpp-log unidpp-issuer \
              unidpp-projector unidpp-gateway unidpp-archive unidpp-console; do
    (cd "$ROOT/../$repo" && cargo build --release >/dev/null 2>&1) \
      || die "rehearse: rebuild failed: $repo"
  done

  echo "rehearse: 4/5 restart (journals replay on the new binaries)"
  "$ROOT/stack.sh" stop >/dev/null
  "$ROOT/stack.sh" start >/dev/null

  echo "rehearse: 5/5 after-readings, parity, append-only proof"
  rehearse_readings "$binds" > "$BACKUPS_DIR/$label.after.json"
  local upgrade_failed=0
  python3 - "$archive" "$BACKUPS_DIR/$label.before.json" \
    "$BACKUPS_DIR/$label.after.json" "$BACKUPS_DIR/$label.json" "$ROOT" <<'PYIN' || upgrade_failed=1
import json, sys, tarfile
archive, before_p, after_p, report_p, root = sys.argv[1:6]
before = json.load(open(before_p))
after = json.load(open(after_p))
domain_equal = all(before[k] == after[k] for k in ("registry_items", "trust_revocations", "log_tree_size") if before.get(k) is not None)
journal_equal = before["journal_lines"] == after["journal_lines"]
# Append-only proof: every journal the backup captured is a byte
# prefix of the live journal (the upgrade rewrote nothing).
prefix_ok, prefix_total = 0, 0
with tarfile.open(archive) as tf:
    for m in tf.getmembers():
        if not (m.isfile() and m.name.endswith(".jsonl")):
            continue
        prefix_total += 1
        archived = tf.extractfile(m).read()
        live = open(f"{root}/{m.name}", "rb").read()
        if live.startswith(archived):
            prefix_ok += 1
ok = domain_equal and journal_equal and prefix_ok == prefix_total
report = {
    "upgrade": before_p.rsplit(".", 1)[0].rsplit(".", 1)[0].split("/")[-1],
    "domain_readings_equal": domain_equal,
    "journal_lines_equal": journal_equal,
    "append_only": f"{prefix_ok}/{prefix_total} backup journals are live-prefix-compatible",
    "before": before, "after": after,
    "result": "GREEN" if ok else "FAILED",
}
json.dump(report, open(report_p, "w"), indent=2, sort_keys=True)
print(f"  domain readings equal: {domain_equal}")
print(f"  journal lines equal:   {journal_equal}")
print(f"  append-only:           {prefix_ok}/{prefix_total}")
if not ok:
    sys.exit(1)
PYIN
  if [ "$upgrade_failed" = 1 ]; then
    die "rehearse FAILED (report kept: backups/$label.json)"
  fi
  rm -f "$BACKUPS_DIR/$label.before.json" "$BACKUPS_DIR/$label.after.json"
  echo "rehearse: GREEN in $(( $(date -u +%s) - started ))s — report: backups/$label.json"
}

case "${1:-}" in
  backup)  shift; cmd_backup "${1:-}" ;;
  schedule) shift; cmd_schedule "${1:-}" ;;
  prune)   shift; cmd_prune "$@" ;;
  drill)   shift; cmd_drill "${1:-}" ;;
  bundle)  shift; [ "${1:-}" ] || die "usage: bundle <tenant> [--data-only] [--out dir]"; cmd_bundle "$@" ;;
  rehearse-upgrade) shift; cmd_rehearse ;;
  restore) shift; [ "${1:-}" ] && [ "${2:-}" ] || die "usage: restore <archive> <name> [--force]"; cmd_restore "$1" "$2" "${3:-}" ;;
  verify)  shift; [ "${1:-}" ] || die "usage: verify <archive>"; cmd_verify "$1" ;;
  *) sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
